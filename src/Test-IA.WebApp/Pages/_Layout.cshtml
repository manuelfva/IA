<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Test-IA</title>
    <link rel="stylesheet" href="~/css/site.css" />
</head>
<body>
    <!-- Aurora Background Orbs -->
    <div class="aurora-wrapper">
        <div class="orb orb--green"></div>
        <div class="orb orb--pink"></div>
    </div>

    <!-- Navbar -->
    <nav class="navbar">
        <a href="/" class="navbar-brand">
            <span class="brand-icon">AD</span>
            <span>Test-IA</span>
        </a>
        <div class="navbar-links">
            <a href="/" class="navbar-link">Home</a>
            <a href="/Users" class="navbar-link">Users</a>
            <a href="/Groups" class="navbar-link">Groups</a>
            <span class="navbar-badge">@Context.User.Identity?.Name</span>
        </div>
    </nav>

    <!-- Main Content -->
    <main class="main-content">
        @RenderBody()
    </main>

    <!-- Footer -->
    <footer class="footer">
        <span>Active Directory Identity Management</span>
        <span class="footer-divider">&middot;</span>
        <span>Powered by .NET 10 &amp; LDAP</span>
    </footer>
</body>
</html>
@page
@model TestIA.WebApp.Pages.IndexModel
@{
    ViewData["Title"] = "Test-IA - Welcome";
}

<!-- Welcome Section -->
<section class="welcome-section">
    <div class="welcome-content">
        <div class="welcome-icon">&#128101;</div>
        <h1>Active Directory Lookup</h1>
        <p class="welcome-subtitle">Search, update, and manage users and groups in your Active Directory domain</p>
    </div>

    <div class="welcome-grid">
        <!-- Users Navigation Card -->
        <a href="/Users" class="nav-card nav-card--users">
            <div class="nav-card-icon nav-card-icon--users">&#128101;</div>
            <div class="nav-card-content">
                <h2 class="nav-card-title">Users Management</h2>
                <p class="nav-card-desc">Search and update user attributes in Active Directory</p>
            </div>
            <span class="nav-card-btn">
                <span>&#8594;</span> Manage Users
            </span>
        </a>

        <!-- Groups Navigation Card -->
        <a href="/Groups" class="nav-card nav-card--groups">
            <div class="nav-card-icon nav-card-icon--groups">&#128101;</div>
            <div class="nav-card-content">
                <h2 class="nav-card-title">Groups Management</h2>
                <p class="nav-card-desc">Search group information and membership in Active Directory</p>
            </div>
            <span class="nav-card-btn">
                <span>&#8594;</span> Manage Groups
            </span>
        </a>
    </div>
</section>

@page
@model TestIA.WebApp.Pages.AccessDeniedModel
@{
    Layout = null;
    ViewData["Title"] = "Access Denied";
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"]</title>
    <link rel="stylesheet" href="~/css/site.css" />
</head>
<body>
    <!-- Aurora Background Orbs -->
    <div class="aurora-wrapper">
        <div class="orb orb--green"></div>
        <div class="orb orb--pink"></div>
    </div>

    <!-- Access Denied Content -->
    <main class="main-content">
        <div class="access-denied-card">
            <div class="access-denied-icon">&#128683;</div>
            <h1 class="access-denied-title">Access Denied</h1>
            <p class="access-denied-message">
                Your account does not have permission to access this application.
            </p>
            <p class="access-denied-submessage">
                Please contact your Active Directory administrator to request access.
            </p>
        </div>
    </main>
</body>
</html>
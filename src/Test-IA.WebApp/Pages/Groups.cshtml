@page
@model TestIA.WebApp.Pages.GroupsModel
@{
    ViewData["Title"] = "Test-IA - Groups Management";
}

<!-- Page Header -->
<div class="page-header">
    <a href="/" class="back-link">&#8592; Back to Home</a>
    <h1>Groups Management</h1>
</div>

<!-- Error Alert -->
@if (!string.IsNullOrEmpty(Model.Error))
{
    <div class="alert alert-error">
        <span class="alert-icon">&#9888;</span>
        <div><strong>Error:</strong> @Model.Error</div>
    </div>
}

<form method="post">
    <!-- ============================================
         GROUP SEARCH SECTION
         ============================================ -->
    <section class="form-section">
        <div class="search-card">
            <div class="card-header">
                <div class="card-header-icon group">&#128101;</div>
                <div>
                    <h2>Search Group</h2>
                    <p class="card-description">Find group details by samAccountName</p>
                </div>
            </div>
            <div class="card-body">
                <div class="form-group">
                    <label for="GroupSearchTerm">samAccountName <span class="label-hint">— e.g. employees of MADRID</span></label>
                    <input type="text" id="GroupSearchTerm" name="GroupSearchTerm"
                           value="@Model.GroupSearchTerm" placeholder="Enter group samAccountName" />
                </div>
            </div>
            <div class="card-footer">
                <button type="submit" name="Action" value="SearchGroup" class="btn btn-secondary">
                    <span>&#128269;</span> Search Group
                </button>
            </div>

            @if (Model.GroupResult != null)
            {
                <div class="result-section">
                    <h3>Group Information <span class="result-badge">Found</span></h3>
                    <div class="result-table">
                        <table>
                            @foreach (var kvp in Model.GroupDisplayValues!)
                            {
                                <tr><th>@kvp.Key</th><td>@kvp.Value</td></tr>
                            }
                        </table>
                    </div>
                </div>
            }
        </div>
    </section>

    <!-- ============================================
         ADD MEMBER TO GROUP SECTION
         ============================================ -->
    <section class="form-section">
        <div class="search-card">
            <div class="card-header">
                <div class="card-header-icon add-member">&#128101;&#43;</div>
                <div>
                    <h2>Add Member to Group</h2>
                    <p class="card-description">Add a user as a member to an existing group</p>
                </div>
            </div>
            <div class="card-body">
                <div class="form-group">
                    <label for="AddMemberGroupSamAccountName">Target Group samAccountName <span class="label-hint">— e.g. IT Department</span></label>
                    <input type="text" id="AddMemberGroupSamAccountName" name="AddMemberGroupSamAccountName"
                           value="@Model.AddMemberGroupSamAccountName" placeholder="Enter group samAccountName" />
                </div>
                <div class="form-group">
                    <label for="AddMemberMemberSamAccountName">Member User samAccountName <span class="label-hint">— e.g. jsmith</span></label>
                    <input type="text" id="AddMemberMemberSamAccountName" name="AddMemberMemberSamAccountName"
                           value="@Model.AddMemberMemberSamAccountName" placeholder="Enter user samAccountName" />
                </div>
            </div>
            <div class="card-footer">
                <button type="submit" name="Action" value="AddMember" class="btn btn-primary">
                    <span>&#128101;&#43;</span> Add Member
                </button>
            </div>

            @if (Model.AddMemberResult != null)
            {
                @if (Model.AddMemberResult.Success)
                {
                    <div class="result-section">
                        <h3>Add Member Result <span class="result-badge success">Success</span></h3>
                        <div class="result-message">
                            <p>@Model.AddMemberResult.Message</p>
                        </div>
                    </div>
                }
                else
                {
                    <div class="alert alert-error">
                        <span class="alert-icon">&#9888;</span>
                        <div><strong>Add Member Failed:</strong> @Model.AddMemberResult.Message</div>
                    </div>
                }
            }
        </div>
    </section>

    <!-- ============================================
         REMOVE MEMBER FROM GROUP SECTION
         ============================================ -->
    <section class="form-section">
        <div class="search-card">
            <div class="card-header">
                <div class="card-header-icon remove-member">&#128101;&#45;</div>
                <div>
                    <h2>Remove Member from Group</h2>
                    <p class="card-description">Remove a user from an existing group</p>
                </div>
            </div>
            <div class="card-body">
                <div class="form-group">
                    <label for="RemoveMemberGroupSamAccountName">Target Group samAccountName <span class="label-hint">— e.g. IT Department</span></label>
                    <input type="text" id="RemoveMemberGroupSamAccountName" name="RemoveMemberGroupSamAccountName"
                           value="@Model.RemoveMemberGroupSamAccountName" placeholder="Enter group samAccountName" />
                </div>
                <div class="form-group">
                    <label for="RemoveMemberMemberSamAccountName">Member User samAccountName <span class="label-hint">— e.g. jsmith</span></label>
                    <input type="text" id="RemoveMemberMemberSamAccountName" name="RemoveMemberMemberSamAccountName"
                           value="@Model.RemoveMemberMemberSamAccountName" placeholder="Enter user samAccountName" />
                </div>
            </div>
            <div class="card-footer">
                <button type="submit" name="Action" value="RemoveMember" class="btn btn-danger">
                    <span>&#128101;&#45;</span> Remove Member
                </button>
            </div>

            @if (Model.RemoveMemberResult != null)
            {
                @if (Model.RemoveMemberResult.Success)
                {
                    <div class="result-section">
                        <h3>Remove Member Result <span class="result-badge success">Success</span></h3>
                        <div class="result-message">
                            <p>@Model.RemoveMemberResult.Message</p>
                        </div>
                    </div>
                }
                else
                {
                    <div class="alert alert-error">
                        <span class="alert-icon">&#9888;</span>
                        <div><strong>Remove Member Failed:</strong> @Model.RemoveMemberResult.Message</div>
                    </div>
                }
            }
        </div>
    </section>
</form>
